# 应用
APP_HOST=127.0.0.1
APP_PORT=18730
APP_SECRET_KEY=
FRONTEND_DIST=frontend/dist

# Qwen 默认模型
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# SSH 跳板机
SSH_HOST=10.168.210.78
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=

# MySQL
MYSQL_HOST=10.168.210.78
MYSQL_PORT=3307
MYSQL_DATABASE=new_four_road_base_ai
MYSQL_USER=Yiviewmysql
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4

# PostgreSQL
PG_HOST=10.168.210.78
PG_PORT=5436
PG_DATABASE=gpsdb
PG_USER=postgres
PG_PASSWORD=

# SeaweedFS
# 对象存储地址：默认走本机隧道端口（28888 转发到 SeaweedFS）；能直连就填直连地址
SEAWEEDFS_BASE_URL=http://127.0.0.1:28888

# RAGFlow
RAGFLOW_BASE_URL=http://127.0.0.1
RAGFLOW_API_KEY=
RAGFLOW_EMBEDDING_MODEL=text-embedding-v3@Tongyi-Qianwen
RAGFLOW_LLM_MODEL=qwen-plus
RAGFLOW_TOP_K=6
RAGFLOW_SIMILARITY_THRESHOLD=0.2
# 向量权重（0~1，剩下给关键词）。实测 0.5 时正确示例只有 0.55 分、和错项挤在一起；
# 0.85 时正确项 0.80~0.84、第二名 0.68~0.71。带编号/桩号的问题会自动偏向关键词（0.35）。
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.85

# 本地数据
DATA_DIR=backend/data
SQL_MAX_ROWS=500
# 下载 CSV 时的行数上限：界面只显示前 SQL_MAX_ROWS 行，导出会按这个上限重取全量。
SQL_EXPORT_MAX_ROWS=50000
CONFIDENCE_THRESHOLD=0.40
# 本地库/日志保留（定时清理任务：删旧记录 + VACUUM 还盘）
LOG_RETENTION_DAYS=7
LOG_MAX_ROWS=20000
HISTORY_RETENTION_DAYS=30
RETRIEVAL_RETENTION_DAYS=30
DB_PURGE_HOURS=6
DB_VACUUM_ENABLED=true
LOG_FILE_MAX_MB=20
NL2SQL_ENGINE=wren
# 生成 SQL 专用模型（留空=用默认模型）。实测 qwen3-coder-plus 优于 qwen3.7-plus 与 qwen3-coder-flash。
NL2SQL_MODEL=
# 校验 / 纠错 / 问题优化用的"裁判模型"（留空=跟随 SEMANTIC_MODEL，再回落到 SQL 模型）。
# 这是判断题，但要判断"用户问了几个点、回复答了几个点"，实测便宜的小模型
# （qwen3.7-flash）会把明显答非所问的回复判通过，所以默认用强通用模型。
# 和写 SQL 的模型分开，能减少"自己判自己"带来的误判。
VERIFY_MODEL=qwen3.7-plus
# 语义理解环节的模型（意图分类 / 拆分 / 上下文补全 / 结果解读 / 后置计算说明 / 数据源判断 /
# 反思改 SQL）。这些环节决定后面整条链路的走向，建议用强通用模型（qwen3.7-plus）。
SEMANTIC_MODEL=qwen3.7-plus
# 任务规划模型（留空=跟随 SEMANTIC_MODEL）。负责拆步骤和执行前契约，适合用另一家强模型交叉校准。
PLANNER_MODEL=
# ReAct 异常调度模型（留空=跟随 SEMANTIC_MODEL）。只在某一步失败时决定重试/补证据/止损。
CONTROLLER_MODEL=
# 同一供应商模型的共享每分钟请求上限，格式：provider/model=rpm，逗号分隔。
# 命中限流时仍会读取 Retry-After；余额不足会立即失败关闭，不做普通重试。
LLM_MODEL_RATE_LIMITS=dashscope/kimi-k2.7-code=3,dashscope/kimi-k2.6=3,moonshot/kimi-k2.7-code=3,moonshot/kimi-k2.6=3
# 回答发出前的反思自检（升级3）：只对分析型/复合型回答跑，检查数字自洽、结论有数据支撑、
# 没有瞎编的比率。关掉可以省一次 LLM 调用。
REFLECT_CHECK_ENABLED=true
# 回答末尾的后续建议（升级4）：主动提示用户接下来可能想知道什么。关掉回答更简洁。
FOLLOWUP_SUGGESTIONS_ENABLED=true
# 查询结果的本地保留策略：只保留最近 RESULT_CACHE_LIMIT 条、且 RESULT_CACHE_TTL_DAYS
# 天内的结果（两条线谁先到清谁）。调大能回看更久，代价是本地库变大（一条约 70KB）。
RESULT_CACHE_LIMIT=2000
RESULT_CACHE_TTL_DAYS=30
# 引擎按「确定性模板 → Wren 语义层（装了 wrenai 才生效）→ 内置 LLM」三级降级，不再有 Vanna。

# Wren AI 语义层（见 docs/WrenAI集成方案.md）
# 需要 Python≥3.11 + wrenai：本机 backend\.venv 已是 3.11 并装好 wrenai 0.14.0
# MDL 由 `wren context build` 生成到 wren_projects\<project>\target\mdl.json（改完 MDL 要重新 build）
WREN_ENABLED=false
# true=把 wren_projects 下 MDL 的模型/字段/指标清单注入提示词（不依赖 wrenai，可单独开）
WREN_USE_MDL_CONTEXT=false
WREN_PROJECTS_DIR=wren_projects
# 语义层（MDL）生成器：legacy = 原 mdl_sync.py；official = 官方流程版（parse-types + validate）
MDL_GENERATOR=legacy

# 悬浮球嵌入：宿主域名（逗号分隔）与访问口令（留空=不校验）
CORS_ALLOW_ORIGINS=*
WIDGET_TOKEN=

# ══════════════════════════════════════════════════════════════════════
# 调参区（改完重启后端生效；不填就用代码里的默认值，下面写的就是默认）
# ══════════════════════════════════════════════════════════════════════

# ── 推荐卡（候选与排序）──────────────────────────────────────────────
# 一张确认卡最多摆几条候选
CAPABILITY_LIMIT=6
# 同类候选上限：通用算子/内置代码模板很容易把卡占满，压住它们
CAPABILITY_PER_KIND_CAP=2
# 多条候选分差 ≤ 这个值（且在同一层内）时，让一次小模型只做排序
CAPABILITY_RERANK_MAX_GAP=0.6
# 确认卡 token 有效期（分钟）：卡片摆出来后多久内点确认还有效
CAPABILITY_TOKEN_TTL_MINUTES=30
# 自动沉淀模板候选排序权重：基础分 + 槽位完备度×加成 − 缺槽数×扣分
AUTO_TEMPLATE_SCORE_BASE=4.0
AUTO_TEMPLATE_SCORE_COMPLETENESS=0.6
AUTO_TEMPLATE_SCORE_MISSING_PENALTY=0.15

# ── 示例直达 / 同义召回（L2）────────────────────────────────────────
# 同问「打分模型」开关：默认关。开着会更准但每题多花 ~20s（候选最后由人在卡上拍板）
RAG_DIRECT_SCORE_ENABLED=false
# 高置信直摆：相似度 ≥ 门槛 + 结构同型 + 与次名分差 ≥ margin → 跳过打分模型直接摆卡
RAG_DIRECT_FAST_ENABLED=true
RAG_DIRECT_FAST_THRESHOLD=0.78
RAG_DIRECT_FAST_MARGIN=0.05
# 同义召回的召回门槛：骨架/向量相似度低于这个值不进候选
EXAMPLE_RECALL_MIN_SCORE=0.4
# 一次向量召回几条（越大越慢）
EXAMPLE_RECALL_TOPK=20
# 检索到的片段相似度下限（示例库 / 问题索引）
RETRIEVAL_MIN_SIMILARITY=0.3

# ── 缓存与 TTL（秒）─────────────────────────────────────────────────
# 进程内缓存条数上限（计划/语义/校验/意图/重排等共用这个量级）
CACHE_MAX_ENTRIES=200
# 查询计划缓存：同一句话在对话里被问两三次，靠它省重复规划
PLAN_CACHE_TTL_SECONDS=300
# 路线台账 / 病害类型字典缓存（库在 SSH 隧道后面，别每题都查）
REFERENCE_DATA_TTL_SECONDS=300
# 字段目录 / 取值样例缓存
FIELD_CATALOG_TTL_SECONDS=600
# 字段目录读库失败后的重试间隔（秒）：失败时先用本地快照顶着，到这个间隔再试实时读
FIELD_CATALOG_RETRY_SECONDS=15
# 看图题一次最多展示/探测多少张（探测是批量做的，84 张约 3 秒）
IMAGE_DISPLAY_LIMIT=120
# "把能调出来的图片全部调出来"这类全库图片清单题一次最多收起/探测多少个图片路径
# （要先把目录里所有图片列的去重路径收齐再判存在，实测全库 323 个；截断会让靠后的列整批看不到）
IMAGE_CATALOG_LIMIT=600
# 图片本地缓存保留天数（缓存目录 data/image_cache）；0 = 不缓存
IMAGE_CACHE_TTL_DAYS=7
# 图片缓存目录大小上限（MB），超了从最旧的开始删；0 = 不限
IMAGE_CACHE_MAX_MB=500
# 宏观元数据查询（"库里都有啥表""哪张表记录最多""某表有哪些字段"）一次最多列多少行
METADATA_LIST_LIMIT=200
# 表行数排名题：对前 N 张表跑精确 COUNT(*)（information_schema 的行数是 InnoDB 估算值，
# 偏差可能过半、排序会错）。设 0 = 只用估算值、不跑精确统计（更快，但排名可能不准）。
METADATA_REFINE_TOP_N=10
# 模板生命周期巡检：被摆到推荐里 N 次、一次都没被复用 → 标记 cold（不进推荐但保留，防误删）
TEMPLATE_COLD_AFTER_OFFERS=10
# cold 判定的最小年龄（天）：刚挖出来的模板不可能"被摆很多次还没人用"（多半是跑批刷的）
TEMPLATE_COLD_MIN_AGE_DAYS=7
# 模板 LLM 审核发现 high 级问题时是否自动降级模板（mature → candidate，退出推荐）。
# 默认 false：审核误报率实测较高（只含一个 {route_id} 的正常模板会被说成"参数错位"），
# 降级会丢掉好模板；审核结论仍会记录并在维护页展示，降不降由人决定。
TEMPLATE_REVIEW_AUTO_DEMOTE=false
# 挖槽的语义补漏：只在"确定性挖槽后还有用户数字留在 SQL 里"时才问一次模型
# （该不该挖、属于哪一列），SQL 替换与校验仍由代码做；正常模板零 LLM 成本。
# false = 退回纯 AST（挖不干净就拒绝沉淀）。
TEMPLATE_MINE_USE_LLM=true
# 编码字典（code→中文）缓存
DICTIONARY_TTL_SECONDS=600
# 示例召回的骨架词表缓存
EXAMPLE_VOCAB_TTL_SECONDS=600
# PG 两张点位表"有没有数据"的探测缓存（跨库路由用它决定 PG 要不要让路）
PG_PROBE_TTL_SECONDS=300

# ── 结果与校验 ──────────────────────────────────────────────────────
# 通用明细一次最多取多少行
GENERIC_DETAIL_LIMIT=500
# 图表推断：一列里数值占比达到这个比例才当数值列
ANALYSIS_NUMERIC_RATIO=0.8
# 数字比对容差（"两边加起来是否等于总数""展示数是否等于总数"这类判断）
NUMBER_COMPARE_EPSILON=0.5
